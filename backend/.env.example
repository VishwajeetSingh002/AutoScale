# Server Configurations
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=ecommerce_db

# Security
JWT_SECRET=supersecretkey123

# Amazon S3 Bucket Uploads (Optional: Fallbacks to local uploads if empty)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
# Note: If running on EC2 with an IAM Role, you do not need AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
